# Railway-compatible Kafka topic initializer (idempotent, RF=1).
# Build context: Messaging/Kafka (service rootDirectory)
#   docker build -f Messaging/Kafka/scripts/Dockerfile.kafka-init -t medicare-kafka-init Messaging/Kafka
#
# Required env:
#   KAFKA_BROKERS=kafka-1.railway.internal:9092
#
# Run once after kafka-1 is healthy. Safe to re-run (--if-not-exists).
FROM confluentinc/cp-kafka:7.4.0

COPY scripts/kafka-init.sh /usr/local/bin/kafka-init.sh

USER root
RUN chmod +x /usr/local/bin/kafka-init.sh

ENTRYPOINT ["/bin/sh", "/usr/local/bin/kafka-init.sh"]
